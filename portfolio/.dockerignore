.git
.venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
# Not committed (see .gitignore) and never used for the build -- no --locked sync,
# so this should never affect the image even if present locally.
uv.lock

# Generated data -- never baked into the image, mounted as a volume instead. Qdrant/
# Postgres data live in their own named Docker volumes, not under ./data.
data/raw_pdfs/
data/processed/
data/uploads/
data/eval/results/

.env
.env.*
!.env.example

# Agent tooling -- 332KB of markdown (mostly the vendored qdrant-* skills) that the image
# never COPYs. Excluded so it isn't shipped to the daemon as build context on every build.
.claude/
