.git
.venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
# Not committed (see .gitignore) and never used for the build -- no --locked sync,
# so this should never affect the image even if present locally.

# Generated data -- never baked into the image, mounted as a volume instead. Qdrant/
# Postgres data live in their own named Docker volumes, not under ./data.
data/raw_pdfs/
data/processed/
data/uploads/
data/eval/results/

.env
.env.*
!.env.example

# Never needed by any image target, and excluded defensively rather than because today's
# Dockerfile would copy them: it `COPY`s explicit paths (`app`, `streamlit_app`,
# `data/manifest.json`), so these only matter the moment someone writes `COPY . .` -- at which
# point tests/ and docs/ silently become part of the runtime image, and `scripts/` puts
# `create_tenant.py` (which mints unrestricted keys) inside the container that serves traffic.
tests/
scripts/
docs/

# Pins the *local dev* interpreter at 3.13; the image runs 3.14. Today the builder only
# `COPY`s pyproject.toml and uv.lock so this file could not reach it -- excluded anyway,
# because a later `COPY . .` would make uv look for a 3.13 that isn't in python:3.14-slim,
# and with UV_PYTHON_DOWNLOADS=0 it cannot fetch one. The build would fail on the sync step
# naming an interpreter, which reads as a broken base image.
.python-version

# Agent tooling -- 332KB of markdown (mostly the vendored qdrant-* skills) that the image
# never COPYs. Excluded so it isn't shipped to the daemon as build context on every build.
.claude/
