## API KEYS ##
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

## Langchain / LangSmith ##
# Optional -- tracing/eval. Every LangChain/LangGraph call (ChatAnthropic, the Qdrant
# retriever, the reranker) is auto-traced once these are set, no code changes needed.
# Leave LANGSMITH_TRACING unset/false to run fully offline.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=portfolio-rag
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

## Qdrant / Postgres ##
# QDRANT_URL=http://localhost:6333 -- docker-compose.yml overrides this to
# http://qdrant:6333 (the compose network hostname) automatically for the api/streamlit
# services; the default here is only for running the app *outside* compose.
# QDRANT_URL=http://localhost:6333

# POSTGRES_USER/PASSWORD/DB: the ONE set of Postgres credentials, used by both
# consumers -- the `postgres` docker-compose service reads these directly (via
# env_file) to initialize itself, and app/config.py's Settings reads the exact same
# three vars to build DATABASE_URL. No second DB_USER/PASSWORD/NAME copy to keep in
# sync. Uncommented (not just documented) because the official postgres image requires
# a password to start.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio

# db_host/db_port/db_driver have no equivalent upstream Postgres-image var to reuse
# (the image doesn't take a "what port am I on" env var), so these stay app-only.
# Defaults are right for a bare/local run; docker-compose.yml overrides DB_HOST to
# `postgres` (the compose network hostname) for the api/streamlit services.
# DB_DRIVER=postgresql+psycopg
# DB_HOST=localhost
# DB_PORT=5432

# Connection pool, tuned per-worker (each gunicorn worker gets its own engine/pool --
# see config.py's db_pool_size comment for the GUNICORN_WORKERS * pool math to watch
# once this runs with more than the default 2 workers).
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# Full DSN override -- set this instead of the vars above to bypass split-var assembly
# entirely (e.g. a managed Postgres connection string from a cloud provider).
# DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio

## Redis ##
# Now a real consumer: app/rate_limit.py keeps per-tenant request counters here. They must
# be shared rather than per-process -- with GUNICORN_WORKERS > 1, in-process counters would
# let through workers x limit requests. docker-compose.yml overrides REDIS_HOST to `redis`
# for the api service; these defaults are for running outside compose.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_USERNAME=
# REDIS_PASSWORD=

## Rate limiting (per tenant, per window) ##
# Uploads get a far tighter budget than questions because they cost far more: Docling
# parsing (CPU), one Anthropic vision call per figure, one Voyage embedding call per chunk.
# /ask is retrieve + rerank + one generation.
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_ASK=60
# RATE_LIMIT_UPLOAD=10
# Document list/status reads. Their own bucket, not /ask's: the API tells clients to poll
# the status route while a document ingests, and each poll used to cost the same as a question.
RATE_LIMIT_DOCUMENTS=120

## Gunicorn / api port (read directly by .docker/Dockerfile's shell CMD and
## .docker/docker-compose.yml, not by Settings -- nothing in app/ needs to know its
## own listening port) ##
# PORT=8000
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=600
# One source of truth: PORT drives gunicorn's --bind, docker-compose.yml's port
# mapping for `api`, and (via a build arg into nginx/Dockerfile*) nginx's upstream
# block -- change it here rather than in three separate places. GUNICORN_TIMEOUT and
# MAX_UPLOAD_SIZE_MB feed nginx's proxy_read_timeout/client_body_timeout and
# client_max_body_size the same way, so nginx can never be the silently stricter half.
#
# IMPORTANT: for any of that to reach docker-compose.yml you must pass --env-file --
# `docker compose -f .docker/docker-compose.yml --env-file .env up` from portfolio/.
# Compose reads `${VAR}` substitutions from the shell or a `.env` in the *project
# directory* (.docker/), never from this file via a service's env_file. Without the flag
# the api container gets the value set here while the port mappings and nginx build args
# get the fallback defaults, and nothing reports the mismatch.
#
# GUNICORN_TIMEOUT is 600 (10 min) because ingestion is synchronous today and a large PDF
# can take minutes; gunicorn's timeout SIGKILLs the worker rather than returning a 504, so
# too low a value looks like a connection fault, not a timeout. Lower it again once uploads
# move behind a job queue (docs/EPIC_4_PLAN.md Phase 5).

# Optional -- sensible defaults are set in app/config.py; uncomment to override.
# ANSWER_MODEL=claude-sonnet-5
# FIGURE_CAPTION_MODEL=claude-sonnet-5
# VOYAGE_MODEL=voyage-4
# `local` needs the optional extra (`uv sync --extra local-reranker`). No shipped image
# installs it, so setting `local` in a container makes the api refuse to boot rather than
# fail every /ask -- deliberate, see config.py::require_reranker_backend. Only these two
# values are accepted; a typo fails at startup rather than silently falling back.
RERANKER_BACKEND=voyage          # "voyage" or "local"
# VOYAGE_RERANK_MODEL=rerank-2.5
# RETRIEVAL_TOP_K=20
# RERANK_TOP_N=5
# MAX_UPLOAD_SIZE_MB=20

# Optional -- CORS. Defaults match the previously-hardcoded CORSMiddleware call in
# api/main.py exactly (open origins, GET/POST only, no extra headers exposed); lock
# these down once there's a real frontend origin. pydantic-settings parses list fields
# from a JSON array, not a comma-separated string.
#
# The `["*"]` default is inert as shipped: CORS_ALLOW_CREDENTIALS is false and
# CORS_ALLOW_HEADERS is empty, so a browser cannot attach `x-api-key` to a cross-origin
# request and nothing authenticated is reachable. Turning credentials on is what makes it
# dangerous -- Starlette answers wildcard-plus-credentials by reflecting whatever Origin
# the caller sent, which trusts every site on the internet with the user's session. The
# app refuses to start on that pair (config.py::_reject_credentialed_wildcard_cors), so
# set both together or neither:
#
#   CORS_ALLOW_ORIGINS=["https://app.example.com"]
#   CORS_ALLOW_CREDENTIALS=true
#
# CORS_ALLOW_ORIGINS=["https://your-frontend.example.com"]
# CORS_ALLOW_METHODS=["GET", "POST"]
# CORS_ALLOW_HEADERS=["Authorization", "Content-Type"]
# CORS_EXPOSE_HEADERS=[]
# CORS_ALLOW_CREDENTIALS=false

# Optional -- Docling CPU threads for the layout/table-structure passes (the CPU-bound
# bulk of ingestion). Unset means os.cpu_count(); Docling's own default is only 4, which
# leaves most of a multi-core box idle. This exact var name is also read by Docling's
# AcceleratorOptions directly, so one setting covers both paths.
# DOCLING_NUM_THREADS=8

## Background ingestion worker ##
# Uploads are queued, not processed in the request: POST /v1/documents returns 202 and the
# `worker` compose service does the parse/chunk/embed. The queue is Postgres (procrastinate),
# so there's no broker URL to set -- it reuses DATABASE_URL.
#
# WORKER_CONCURRENCY x DOCLING_NUM_THREADS is what competes for CPU cores. Neither number
# means anything on its own: 2 x 4 fits an 8-vCPU box, 4 x 8 oversubscribes it by 4x and makes
# concurrent ingests *slower* than sequential ones. Raise one only alongside lowering the other.
# WORKER_CONCURRENCY=2

# API authentication has no env vars: keys live in the `api_keys` table, minted with
#   uv run python scripts/create_tenant.py "My Org"
# which prints the key once. Send it as the `x-api-key` header. There is deliberately no
# "master key" setting -- a key in env would be unrevocable and unrotatable.

# Optional -- logging (app/logs.py). LOG_JSON=true renders every log line -- ours via
# structlog, and stdlib logging from uvicorn/dependencies -- as JSON; leave false for a
# colorized console format that's easier to read locally.
# LOG_LEVEL=INFO
# LOG_JSON=false
