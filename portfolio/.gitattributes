# Global settings
*                   text=auto

# Generated files
# Mark as generated for GitHub language stats; disable diffs/merges for locks
*.lock              linguist-generated -diff -merge

# uv.lock is committed (unlike other *.lock here), so it must stay diffable: a lockfile diff is
# precisely where a dependency version change -- including an unintended one -- becomes visible
# in review, and `-diff` above renders it as "Binary files differ". `-merge` is kept, because a
# lockfile conflict has no sane 3-way resolution; re-run `uv lock` instead.
uv.lock             linguist-generated -merge diff
package-lock.json   linguist-generated -diff -merge
*_auto_*.py         linguist-generated
*.svg               linguist-generated
*.mjml              linguist-generated
.isort.cfg          linguist-generated

# Merge strategies
# Specific merge behaviors for localization and changelogs
*.po                -merge
CHANGELOG.md        merge=union

#
# The above will handle all files NOT found below
#
# These files are text and should be normalized (Convert crlf => lf)
*.gitattributes text
.gitignore      text
*.md            text diff=markdown

#
# Exclude files from exporting
#

.gitattributes  export-ignore
.gitignore      export-ignore

# Source files
# ============
*.pxd    text diff=python
*.py     text diff=python
*.py3    text diff=python
*.pyw    text diff=python
*.pyx    text diff=python
*.pyz    text diff=python
*.pyi    text diff=python

# Binary files
# ============
*.db     binary
*.p      binary
*.pkl    binary
*.pickle binary
*.pyc    binary export-ignore
*.pyo    binary export-ignore
*.pyd    binary
*.svg    binary

# Jupyter notebook
*.ipynb  text eol=lf

# Note: .db, .p, and .pkl files are associated
# with the python modules ``pickle``, ``dbm.*``,
# ``shelve``, ``marshal``, ``anydbm``, & ``bsddb``
# (among others).
